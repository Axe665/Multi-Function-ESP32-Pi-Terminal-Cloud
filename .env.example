# 云节点部署变量（docker/compose.yml 用）
# 复制成 .env 后按需改；不填就用括号里的默认值

CLOUD_ID=cloud-home-01
CLOUD_NAME=私有云 · 家庭实验室

# Postgres（容器内已经拼好 CLOUD_PG_DSN，这里只给密码）
CLOUD_DB_PASSWORD=cloud

# 边 → 云 的令牌；公网部署必须设置
CLOUD_EDGE_TOKEN=
# 管理员令牌（不设 + 不设口令 = 本机演示模式）
CLOUD_ADMIN_TOKEN=

# 管理员登录（多机部署务必开）
CLOUD_ADMIN_PASSWORD=
CLOUD_ADMIN_TOTP=
CLOUD_SESSION_KEY=

# 备份落在宿主机哪个目录（文档要求外接盘，指过去就行）
CLOUD_BACKUP_HOST_DIR=../backups

# AI：local = 本地 Ollama；rules = 只用规则模板；api = 公有 API（需显式开启）
CLOUD_AI_MODE=local
CLOUD_OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
