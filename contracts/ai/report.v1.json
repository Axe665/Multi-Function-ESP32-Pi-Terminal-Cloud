{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Axe665/Multi-Function-ESP32-Pi-Terminal-Cloud/contracts/ai/report.v1.json",
  "title": "ai.report.v1 —— 云内部报告",
  "description": "模型输出必须落成这个形状，否则重试两次后改用规则模板。报告不接受空内容。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scope", "period", "headline", "narrative", "confidence"],
  "task": { "enum": ["weekly_narrative", "fleet_compare", "advice_digest", "wordcloud_label"] },
  "properties": {
    "schema": { "const": "ai.report.v1" },
    "task": { "enum": ["weekly_narrative", "fleet_compare", "advice_digest", "wordcloud_label"] },
    "scope": { "enum": ["fleet", "edge", "device"] },
    "scope_id": { "type": ["string", "null"] },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "to": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "headline": { "type": "string", "minLength": 1, "maxLength": 80 },
    "narrative": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "findings": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "detail", "risk"],
        "properties": {
          "label": { "type": "string" },
          "detail": { "type": "string" },
          "risk": { "enum": ["info", "watch", "alert"] }
        }
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "maxLength": 120 }
    },
    "confidence": { "enum": ["high", "low"] }
  }
}
