# 公网只放行两条 API；管理台与 Ollama 仅内网。
# 证书用 cloud-ca 签发（内网自签根），边缘节点预置 cloud-ca.crt。

{
	# 边 → 云：只这一条写接口
	@ingest path /api/v1/ingest/edge-report
	handle @ingest {
		reverse_proxy cloud:8002
	}

	# 健康检查给运维用
	@health path /api/v1/health
	handle @health {
		reverse_proxy cloud:8002
	}

	# 其余一律拒绝：管理台不做公网域名
	handle {
		respond "not exposed" 404
	}

	tls {
		issuer internal {
			lifetime 720h
		}
	}
}
