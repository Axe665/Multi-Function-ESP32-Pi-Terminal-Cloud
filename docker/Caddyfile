# 公网只放行两条 API；管理台与 Ollama 只在内网。
# 证书用 cloud-ca 签发（内网自签根），边的 mTLS 预置同一份根。
{
	# 边 → 云：唯一写入口
	@ingest path /api/v1/ingest/edge-report
	handle @ingest {
		reverse_proxy api:8002
	}

	# 运维健康检查
	@health path /api/v1/health
	handle @health {
		reverse_proxy api:8002
	}

	# 管理 API（内网）
	handle /api/* {
		reverse_proxy api:8002
	}

	# 管理台前端（内网）
	handle {
		reverse_proxy web:8080
	}

	tls {
		issuer internal {
			lifetime 720h
		}
	}
}
