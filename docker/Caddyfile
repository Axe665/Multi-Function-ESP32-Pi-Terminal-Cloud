# 两个监听：
#   443 —— 管理台与内网 API，cloud-ca 签发的站点证书
#   8443 —— 只给边上报用，强制客户端证书（文档 §5.8 的 mTLS）
# 本机明文入口：只绑 127.0.0.1，给本机调试和截图用（公网仍然只有 443/8443）
# 浏览器和 curl 对 IP 字面量不发 SNI（RFC 6066）；:443 上有多站点时，
# 没有 SNI 就选不到站点，握手直接 internal error。管理台常按内网 IP 访问，
# 所以给一个默认 SNI。
{
	default_sni {$CLOUD_DOMAIN:localhost}
}

http://:8088 {
	# 本地模型的调试入口放这里：8088 只绑 127.0.0.1，443 上不再有免鉴权分支
	handle /ollama/* {
		reverse_proxy ollama:11434
	}
	handle /api/* {
		reverse_proxy api:8002
	}
	handle {
		reverse_proxy web:8080
	}
}

# 域名与内网 IP 都算这个站点的地址。只写域名时，按 IP 访问会在 TLS 握手
# 阶段就被拒（no certificate available for SNI），管理台上不去。
{$CLOUD_DOMAIN:localhost} {$CLOUD_LAN_IP} {
	tls /certs/cloud.crt /certs/cloud.key

	# Ollama 只在 8088（127.0.0.1）上开放，443 明确拒绝，别落到前端兜底里
	handle /ollama/* {
		respond "not exposed" 403
	}
	# 摄取只走 8443 的 mTLS 监听。这条必须排在 /api/* 前面：443 上没有
	# client_auth，把 ingest 放进来等于让任何人自带 CN 头冒充边。
	handle /api/v1/ingest/* {
		respond "ingest only on 8443 with mTLS" 403
	}
	# 管理 API 与前端（内网；管理接口本身还要过 admin_guard）
	handle /api/* {
		request_body {
			max_size 2MB
		}
		reverse_proxy api:8002 {
			# 443 没有客户端证书，这个头一个都不许透传；清掉再检一遍请求，
			# 免得以后新加的接口误信它
			header_up X-Client-CN ""
			header_up X-Forwarded-Client-Cert ""
		}
	}
	handle {
		reverse_proxy web:8080
	}
}

:8443 {
	tls /certs/cloud.crt /certs/cloud.key {
		# 只认 cloud-ca 签发的边证书
		client_auth {
			mode require_and_verify
			trust_pool file /certs/cloud-ca.crt
		}
	}

	handle /api/v1/ingest/edge-report {
		request_body {
			max_size 2MB
		}
		reverse_proxy api:8002 {
			# 证书链已由上面的 client_auth 验过，CN 才是可信的边身份
			header_up X-Client-CN {http.request.tls.client.subject}
		}
	}
	handle /api/v1/health {
		reverse_proxy api:8002
	}
	handle {
		respond "not exposed" 403
	}
}
