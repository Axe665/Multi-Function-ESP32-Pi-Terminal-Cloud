# 两个监听：
#   443 —— 管理台与内网 API，cloud-ca 签发的站点证书
#   8443 —— 只给边上报用，强制客户端证书（文档 §5.8 的 mTLS）
# 本机明文入口：只绑 127.0.0.1，给本机调试和截图用（公网仍然只有 443/8443）
http://:8088 {
	handle /api/* {
		reverse_proxy api:8002
	}
	handle {
		reverse_proxy web:8080
	}
}

{$CLOUD_DOMAIN:localhost} {
	tls /certs/cloud.crt /certs/cloud.key

	# 本地模型的统一入口（文档 §6.1，仅内网；ollama profile 没起时 502）
	handle /ollama/* {
		reverse_proxy ollama:11434
	}
	# 管理 API 与前端（内网）
	handle /api/* {
		reverse_proxy api:8002
	}
	handle {
		reverse_proxy web:8080
	}
}

:8443 {
	tls /certs/cloud.crt /certs/cloud.key {
		# 只认 cloud-ca 签发的边证书
		client_auth {
			mode require_and_verify
			trust_pool file /certs/cloud-ca.crt
		}
	}

	handle /api/v1/ingest/edge-report {
		reverse_proxy api:8002
	}
	handle /api/v1/health {
		reverse_proxy api:8002
	}
	handle {
		respond "not exposed" 403
	}
}
