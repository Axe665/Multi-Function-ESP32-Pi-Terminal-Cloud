# 两个监听：
#   443 —— 管理台与内网 API，cloud-ca 签发的站点证书
#   8443 —— 只给边上报用，强制客户端证书（文档 §5.8 的 mTLS）
# 本机明文入口：只绑 127.0.0.1，给本机调试和截图用（公网仍然只有 443/8443）
http://:8088 {
	# 本地模型的调试入口放这里：8088 只绑 127.0.0.1，443 上不再有免鉴权分支
	handle /ollama/* {
		reverse_proxy ollama:11434
	}
	handle /api/* {
		reverse_proxy api:8002
	}
	handle {
		reverse_proxy web:8080
	}
}

{$CLOUD_DOMAIN:localhost} {
	tls /certs/cloud.crt /certs/cloud.key

	# Ollama 只在 8088（127.0.0.1）上开放，443 明确拒绝，别落到前端兜底里
	handle /ollama/* {
		respond "not exposed" 403
	}
	# 管理 API 与前端（内网；管理接口本身还要过 admin_guard）
	handle /api/* {
		request_body {
			max_size 2MB
		}
		reverse_proxy api:8002
	}
	handle {
		reverse_proxy web:8080
	}
}

:8443 {
	tls /certs/cloud.crt /certs/cloud.key {
		# 只认 cloud-ca 签发的边证书
		client_auth {
			mode require_and_verify
			trust_pool file /certs/cloud-ca.crt
		}
	}

	handle /api/v1/ingest/edge-report {
		request_body {
			max_size 2MB
		}
		reverse_proxy api:8002 {
			# 证书链已由上面的 client_auth 验过，CN 才是可信的边身份
			header_up X-Client-CN {http.request.tls.client.subject}
		}
	}
	handle /api/v1/health {
		reverse_proxy api:8002
	}
	handle {
		respond "not exposed" 403
	}
}
